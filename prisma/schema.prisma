generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus { ACTIVE INACTIVE }
enum LotStatus { RECEIVED IN_PROCESS ON_HOLD COMPLETED REJECTED CANCELLED }
enum ReceiptStatus { DRAFT CONFIRMED CANCELLED }
enum ProcessExecutionStatus { PENDING IN_PROGRESS COMPLETED ON_HOLD CANCELLED }
enum ProductionOrderStatus { DRAFT RELEASED IN_PROGRESS COMPLETED CANCELLED }
enum MachineStatus { AVAILABLE IN_USE MAINTENANCE INACTIVE }
enum LotRelationType { SPLIT MERGE REPROCESS TRANSFORM }
enum MovementType { RECEIPT TRANSFER PROCESS_IN PROCESS_OUT SPLIT MERGE ADJUSTMENT REJECTION FINISHED_GOODS }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles UserRole[]
}

model Role {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Supplier {
  id String @id @default(cuid())
  code String @unique
  name String
  taxId String?
  phone String?
  email String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts RawHideReceipt[]
}

model Customer {
  id String @id @default(cuid())
  code String @unique
  name String
  taxId String?
  phone String?
  email String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productionOrders ProductionOrder[]
}

model Warehouse {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lotMovements LotMovement[]
}

model Machine {
  id String @id @default(cuid())
  code String @unique
  name String
  type String
  capacityKg Decimal? @db.Decimal(12,3)
  status MachineStatus @default(AVAILABLE)
  active Boolean @default(true)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  executions LotProcess[]
}

model RawHideReceipt {
  id String @id @default(cuid())
  folio String @unique
  supplierId String
  receiptDate DateTime
  status ReceiptStatus @default(DRAFT)
  transportRef String?
  origin String?
  notes String?
  totalHides Int @default(0)
  totalWeightKg Decimal @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplier Supplier @relation(fields: [supplierId], references: [id])
  items RawHideReceiptItem[]
  lots TanneryLot[]
  @@index([supplierId, receiptDate])
}

model RawHideReceiptItem {
  id String @id @default(cuid())
  receiptId String
  animalType String
  preservation String?
  qualityGrade String?
  hidesQuantity Int
  weightKg Decimal @db.Decimal(12, 3)
  unitCost Decimal? @db.Decimal(14, 4)
  notes String?
  receipt RawHideReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  @@index([receiptId])
}

model ProductionRoute {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  steps ProductionRouteStep[]
  orders ProductionOrder[]
}

model ProductionRouteStep {
  id String @id @default(cuid())
  routeId String
  processId String
  sequence Int
  estimatedMinutes Int?
  preferredMachineType String?
  required Boolean @default(true)
  route ProductionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  process ProcessCatalog @relation(fields: [processId], references: [id])
  executions LotProcess[]
  @@unique([routeId, sequence])
  @@index([processId])
}

model ProductionOrder {
  id String @id @default(cuid())
  folio String @unique
  customerId String?
  routeId String?
  articleCode String?
  targetColor String?
  requestedHides Int?
  requestedWeightKg Decimal? @db.Decimal(12,3)
  dueDate DateTime?
  status ProductionOrderStatus @default(DRAFT)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields: [customerId], references: [id])
  route ProductionRoute? @relation(fields: [routeId], references: [id])
  lots TanneryLot[]
  executions LotProcess[]
  @@index([status, dueDate])
  @@index([routeId])
}

model TanneryLot {
  id String @id @default(cuid())
  folio String @unique
  receiptId String?
  parentLotId String?
  productionOrderId String?
  articleCode String?
  animalType String
  status LotStatus @default(RECEIVED)
  currentProcessCode String?
  initialHides Int
  currentHides Int
  initialWeightKg Decimal @db.Decimal(12, 3)
  currentWeightKg Decimal @db.Decimal(12, 3)
  color String?
  qrToken String @unique @default(cuid())
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipt RawHideReceipt? @relation(fields: [receiptId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  parentLot TanneryLot? @relation("LotHierarchy", fields: [parentLotId], references: [id])
  childLots TanneryLot[] @relation("LotHierarchy")
  sourceRelations LotRelation[] @relation("LotRelationParent")
  targetRelations LotRelation[] @relation("LotRelationChild")
  processes LotProcess[]
  movements LotMovement[]
  @@index([status])
  @@index([receiptId])
  @@index([productionOrderId])
  @@index([parentLotId])
}

model LotRelation {
  id String @id @default(cuid())
  parentLotId String
  childLotId String
  relationType LotRelationType
  hidesQuantity Int?
  weightKg Decimal? @db.Decimal(12,3)
  notes String?
  createdAt DateTime @default(now())
  parentLot TanneryLot @relation("LotRelationParent", fields: [parentLotId], references: [id], onDelete: Cascade)
  childLot TanneryLot @relation("LotRelationChild", fields: [childLotId], references: [id], onDelete: Cascade)
  @@unique([parentLotId, childLotId, relationType])
  @@index([childLotId])
}

model ProcessCatalog {
  id String @id @default(cuid())
  code String @unique
  name String
  sequence Int
  description String?
  active Boolean @default(true)
  requiresWeight Boolean @default(true)
  requiresHides Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  executions LotProcess[]
  routeSteps ProductionRouteStep[]
  @@index([sequence])
}

model LotProcess {
  id String @id @default(cuid())
  lotId String
  processId String
  machineId String?
  routeStepId String?
  productionOrderId String?
  status ProcessExecutionStatus @default(PENDING)
  startedAt DateTime?
  completedAt DateTime?
  inputHides Int?
  outputHides Int?
  inputWeightKg Decimal? @db.Decimal(12, 3)
  outputWeightKg Decimal? @db.Decimal(12, 3)
  temperatureC Decimal? @db.Decimal(6, 2)
  ph Decimal? @db.Decimal(5, 2)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lot TanneryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  process ProcessCatalog @relation(fields: [processId], references: [id])
  machine Machine? @relation(fields: [machineId], references: [id])
  routeStep ProductionRouteStep? @relation(fields: [routeStepId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  @@index([lotId, status])
  @@index([processId, status])
  @@index([machineId, status])
  @@index([routeStepId])
  @@index([productionOrderId])
}

model LotMovement {
  id String @id @default(cuid())
  lotId String
  warehouseId String?
  type MovementType
  occurredAt DateTime @default(now())
  hidesQuantity Int?
  weightKg Decimal? @db.Decimal(12, 3)
  reference String?
  notes String?
  lot TanneryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  @@index([lotId, occurredAt])
  @@index([warehouseId, occurredAt])
}
