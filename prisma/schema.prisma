generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LotStatus {
  RECEIVED
  IN_PROCESS
  ON_HOLD
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ProcessExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MovementType {
  RECEIPT
  TRANSFER
  PROCESS_IN
  PROCESS_OUT
  SPLIT
  MERGE
  ADJUSTMENT
  REJECTION
  FINISHED_GOODS
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  roles     UserRole[]
}

model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  taxId     String?
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts  RawHideReceipt[]
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  taxId     String?
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lotMovements LotMovement[]
}

model RawHideReceipt {
  id            String        @id @default(cuid())
  folio         String        @unique
  supplierId    String
  receiptDate   DateTime
  status        ReceiptStatus @default(DRAFT)
  transportRef  String?
  origin        String?
  notes         String?
  totalHides    Int           @default(0)
  totalWeightKg Decimal       @db.Decimal(12, 3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier Supplier             @relation(fields: [supplierId], references: [id])
  items    RawHideReceiptItem[]
  lots     TanneryLot[]

  @@index([supplierId, receiptDate])
}

model RawHideReceiptItem {
  id            String   @id @default(cuid())
  receiptId     String
  animalType    String
  preservation  String?
  qualityGrade  String?
  hidesQuantity Int
  weightKg      Decimal  @db.Decimal(12, 3)
  unitCost      Decimal? @db.Decimal(14, 4)
  notes         String?

  receipt RawHideReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model TanneryLot {
  id                 String    @id @default(cuid())
  folio              String    @unique
  receiptId          String?
  parentLotId        String?
  articleCode        String?
  animalType         String
  status             LotStatus @default(RECEIVED)
  currentProcessCode String?
  initialHides       Int
  currentHides       Int
  initialWeightKg    Decimal   @db.Decimal(12, 3)
  currentWeightKg    Decimal   @db.Decimal(12, 3)
  color              String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  receipt   RawHideReceipt? @relation(fields: [receiptId], references: [id])
  parentLot TanneryLot?      @relation("LotHierarchy", fields: [parentLotId], references: [id])
  childLots TanneryLot[]     @relation("LotHierarchy")
  processes LotProcess[]
  movements LotMovement[]

  @@index([status])
  @@index([receiptId])
  @@index([parentLotId])
}

model ProcessCatalog {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  sequence       Int
  description    String?
  active         Boolean  @default(true)
  requiresWeight Boolean  @default(true)
  requiresHides  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  executions LotProcess[]

  @@index([sequence])
}

model LotProcess {
  id             String                 @id @default(cuid())
  lotId          String
  processId      String
  status         ProcessExecutionStatus @default(PENDING)
  machineCode    String?
  startedAt      DateTime?
  completedAt    DateTime?
  inputHides     Int?
  outputHides    Int?
  inputWeightKg  Decimal?               @db.Decimal(12, 3)
  outputWeightKg Decimal?               @db.Decimal(12, 3)
  temperatureC   Decimal?               @db.Decimal(6, 2)
  ph             Decimal?               @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  lot     TanneryLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  process ProcessCatalog @relation(fields: [processId], references: [id])

  @@index([lotId, status])
  @@index([processId, status])
}

model LotMovement {
  id            String       @id @default(cuid())
  lotId         String
  warehouseId   String?
  type          MovementType
  occurredAt    DateTime     @default(now())
  hidesQuantity Int?
  weightKg      Decimal?     @db.Decimal(12, 3)
  reference     String?
  notes         String?

  lot       TanneryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([lotId, occurredAt])
  @@index([warehouseId, occurredAt])
}
