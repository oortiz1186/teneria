[Unit]
Description=Teneria ERP coordinated backup
After=network.target

[Service]
Type=oneshot
User=teneria
Group=teneria
WorkingDirectory=/opt/teneria/app
Environment=TENERIA_APP_DIR=/opt/teneria/app
Environment=TENERIA_ENV_FILE=/opt/teneria/app/.env
Environment=TENERIA_BACKUP_ROOT=/var/backups/teneria
Environment=TENERIA_BACKUP_RETENTION_DAYS=14
ExecStart=/bin/bash /opt/teneria/app/scripts/backup-teneria.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups/teneria /var/lib/teneria
