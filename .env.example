DATABASE_URL="postgresql://teneria:teneria_dev@localhost:5434/teneria?schema=public"
NEXT_PUBLIC_APP_NAME="Tenería ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Genera un secreto aleatorio largo (mínimo 32 caracteres) y no lo subas al repo.
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Usuario administrador inicial. La contraseña debe tener mínimo 12 caracteres.
AUTH_BOOTSTRAP_EMAIL="admin@teneria.local"
AUTH_BOOTSTRAP_PASSWORD="cambia-esta-contrasena-segura"
AUTH_BOOTSTRAP_NAME="Administrador"

# Archivos adjuntos. En producción usa una ruta persistente fuera del repositorio.
DOCUMENT_STORAGE_PATH="/var/lib/teneria/documents"
# 15 MB por defecto.
DOCUMENT_MAX_BYTES="15728640"
